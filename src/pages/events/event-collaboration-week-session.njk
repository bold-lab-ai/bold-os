---
pagination:
  data: collabWeekSessions
  size: 1
  alias: session
permalink: "event-collaboration-week-session-{{ session.slug }}.html"
eleventyComputed:
  title: "{{ session.title }} | BOLD Collaboration Week"
  description: "{{ session.day }}, {{ session.time }} — BOLD Collaboration Week."
sdk: ["firestore", "functions"]
css: "event-collaboration-week-session"
scripts: ["collab-week-speakers.js", "pages/event-collaboration-week-session.js"]
---
<div class="detail">
  <a class="detail-back" href="event-collaboration-week.html">&larr; Back to schedule</a>
  <div id="sessionBody"></div>
</div>
<script type="application/json" id="sessionData">{{ session | jsonScript | safe }}</script>
<script type="application/json" id="sessionTypes">{{ collabWeekTypes | jsonScript | safe }}</script>
<script type="application/json" id="sessionLocation">{{ collabWeekLocations | findBySlug(session.locationSlug) | jsonScript | safe }}</script>
