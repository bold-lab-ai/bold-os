---
pagination:
  data: collections.collabWeekTalks
  size: 1
  alias: talk
permalink: "event-collaboration-week-talk-{{ talk.slug }}.html"
eleventyComputed:
  title: "{{ talk.title }} | BOLD Collaboration Week"
  description: "A talk at BOLD Collaboration Week."
css: "event-collaboration-week-session"
sdk: ["firestore", "functions"]
scripts: ["pages/event-collaboration-week-talk.js"]
---
{% set venue = collabWeekLocations | findBySlug(talk.locationSlug) %}
<div class="detail">
  {% if talk.sessionSlug %}
  <a class="detail-back" href="event-collaboration-week-session-{{ talk.sessionSlug }}.html">&larr; Back to {{ talk.sessionTitle }}</a>
  {% else %}
  <a class="detail-back" href="event-collaboration-week.html">&larr; Back to schedule</a>
  {% endif %}

  <div id="talkBody">
  {% if talk.type %}<span class="type-badge type-{{ talk.type }}">{{ collabWeekTypes[talk.type] }}</span>{% endif %}
  <div class="detail-head"><h2>{{ talk.title }}</h2></div>

  <dl class="detail-grid">
    {% if talk.speaker %}<dt>Speaker</dt><dd>{{ talk.speaker }}{% if talk.affiliation %} <span class="detail-muted">({{ talk.affiliation }})</span>{% endif %}</dd>{% endif %}
    {% if talk.sessionSlug %}<dt>Session</dt><dd><a href="event-collaboration-week-session-{{ talk.sessionSlug }}.html">{{ talk.sessionTitle }}</a></dd>{% endif %}
    {% if talk.day %}<dt>When</dt><dd>{{ talk.day }}{% if talk.time %}, {{ talk.time }}{% endif %}</dd>{% endif %}
    {% if venue %}<dt>Where</dt><dd>{{ venue.name }} &middot; <a href="{{ venue.mapsUrl }}" target="_blank" rel="noopener">Open in Google Maps</a><span class="meta">{{ venue.address }}</span></dd>{% endif %}
    {% if talk.duration %}<dt>Duration</dt><dd>{{ talk.duration }}</dd>{% endif %}
    {% if talk.notes %}<dt>Notes</dt><dd>{{ talk.notes }}</dd>{% endif %}
  </dl>

  <div class="detail-field">
    <p class="detail-field-label">Abstract</p>
    {% if talk.abstract %}<p>{{ talk.abstract }}</p>{% else %}<p class="detail-muted">Abstract not yet available.</p>{% endif %}
  </div>
  {% if talk.bio %}
  <div class="detail-field">
    <p class="detail-field-label">About the speaker</p>
    <p>{{ talk.bio }}</p>
  </div>
  {% endif %}
  </div>
</div>
<script type="application/json" id="talkData">{{ talk | jsonScript | safe }}</script>
<script type="application/json" id="talkTypes">{{ collabWeekTypes | jsonScript | safe }}</script>
<script type="application/json" id="talkLocation">{{ venue | jsonScript | safe }}</script>
