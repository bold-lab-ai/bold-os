---
area: "events"
title: "Collaboration week | BOLD Lab"
description: "Collaboration week: five days, every three months, for BOLD Associates to engage more deeply with BOLD, in person."
sdk: ["firestore", "functions"]
css: "event-collaboration-week"
nav: "events.html"
scripts: ["events-common.js", "event-schedule.js", "event-sessions.js", "project-links.js", "event-proposals.js", "series-editions.js", "pages/event.js", "pages/event-series-page.js"]
permalink: "event-collaboration-week.html"
---
{# The series' own page (eventSeries/collaboration-week): one occurrence at a time (series-editions.js), its header from Firestore (pages/event.js). #}
<nav class="ed-switch" id="editionSwitch" aria-label="Occurrences" hidden></nav>
<div class="hero" id="eventBody" data-series="collaboration-week" data-event="collaboration-week">
  <a class="back-link" href="events.html">&larr; All events</a>
  <p class="hero-when">Loading…</p>
</div>

<main>
  <div class="tabs" role="tablist" aria-label="Collaboration week">
    <button class="tab" type="button" id="tabBtnSchedule" data-tab="schedule" role="tab" aria-controls="panelSchedule">Schedule</button>
    <button class="tab" type="button" id="tabBtnProposals" data-tab="proposals" role="tab" aria-controls="panelProposals">Proposals</button>
  </div>

  <div class="tab-panel" id="panelSchedule" role="tabpanel" aria-labelledby="tabBtnSchedule">
    {# Days, time slots and sessions: Firestore, drawn by event-sessions.js (from pages/event.js). #}
    <div class="schedule" id="eventSchedule"><p class="sched-empty">Loading…</p></div>
  </div>

  <div class="tab-panel" id="panelProposals" role="tabpanel" aria-labelledby="tabBtnProposals">
    <div id="proposalsSignedOut">
      <p>Sign in with Slack to see what's been proposed.</p>
      <button class="auth-signin" type="button" id="signInBtn">Sign in with Slack</button>
    </div>

    <div id="proposalsSignedIn" hidden>
      <p><a id="proposeLink" href="event-collaboration-week-propose.html">Propose a workshop, pitch or talk &rarr;</a></p>
      <div id="proposalsList"></div>
    </div>
  </div>
</main>

<script type="application/json" id="eventTypes">{{ collabWeekTypes | jsonScript | safe }}</script>
