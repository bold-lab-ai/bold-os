<!DOCTYPE html>
<html lang="en"{% if htmlClass %} class="{{ htmlClass }}"{% endif %}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script>/* Dark theme (bold.css, bold.js mountTheme): set before anything paints. */ try { if (localStorage.getItem('boldTheme') === 'dark') document.documentElement.setAttribute('data-theme', 'dark'); } catch (e){}</script>
<title>{{ title | safe }}</title>
{% if description %}<meta name="description" content="{{ description | safe }}">
<meta property="og:title" content="{{ title | safe }}">
<meta property="og:description" content="{{ description | safe }}">
<meta property="og:type" content="website">
{% endif %}<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="{{ site.fonts }}" rel="stylesheet">
{% for name in [ 'app', 'auth', 'firestore' ] | concat(sdk or []) | concat(['functions'] if site.testMode else []) | uniq %}<script src="https://www.gstatic.com/firebasejs/{{ site.firebaseSdkVersion }}/firebase-{{ name }}-compat.js"></script>
{% endfor %}<link rel="stylesheet" href="assets/css/bold.css?v={{ build.stamp }}">
{% if headExtra %}{{ headExtra | safe }}
{% endif %}{% for name in styles or [] %}<link rel="stylesheet" href="assets/css/{{ name }}.css?v={{ build.stamp }}">
{% endfor %}{% if css %}<link rel="stylesheet" href="assets/css/pages/{{ css }}.css?v={{ build.stamp }}">
{% endif %}<script>window.BOLD_CONFIG = {{ site.firebase | dump | safe }}; window.BOLD_SLACK_TEAM = {{ site.slackTeam | dump | safe }};</script>
{% if site.testMode %}<script>window.BOLD_TEST = true;</script>
{% endif %}<script src="assets/js/bold.js?v={{ build.stamp }}"></script>
{% if site.testMode %}<script src="assets/js/test-mode.js?v={{ build.stamp }}"></script>
{% endif %}
</head>
<body>
{% if emulatorWarning %}
<div id="emulatorWarning" class="emulator-warning" hidden>&#9888; FIRESTORE EMULATOR MODE &mdash; this is NOT real data. Never commit FIRESTORE_USE_EMULATOR as true.</div>
{% endif %}
{% if not bare %}{% include "partials/masthead.njk" %}{% endif %}
{% if not public %}{% include "partials/gate.njk" %}{% endif %}
{% include "partials/shell-open.njk" %}
{{ content | safe }}
{% if not noFooter and not bare %}{% include "partials/footer.njk" %}{% endif %}
{% include "partials/shell-close.njk" %}
<script src="assets/js/search-box.js?v={{ build.stamp }}"></script>
{% for script in scripts %}<script src="assets/js/{{ script }}?v={{ build.stamp }}"></script>
{% endfor %}{% if not public %}<script src="assets/js/mentions.js?v={{ build.stamp }}"></script>
{% if not ('markdown.js' in (scripts or [])) %}<script src="assets/js/markdown.js?v={{ build.stamp }}"></script>
{% endif %}<script src="assets/js/md-field.js?v={{ build.stamp }}"></script>
{% endif %}
</body>
</html>
