<!DOCTYPE html>
<html lang="en"{% if htmlClass %} class="{{ htmlClass }}"{% endif %}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title | safe }}</title>
{% if description %}<meta name="description" content="{{ description | safe }}">
<meta property="og:title" content="{{ title | safe }}">
<meta property="og:description" content="{{ description | safe }}">
<meta property="og:type" content="website">
{% endif %}<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="{{ site.fonts }}" rel="stylesheet">
{% for name in [ 'app', 'auth' ] | concat(sdk or []) %}<script src="https://www.gstatic.com/firebasejs/{{ site.firebaseSdkVersion }}/firebase-{{ name }}-compat.js"></script>
{% endfor %}<link rel="stylesheet" href="assets/css/bold.css">
{% if headExtra %}{{ headExtra | safe }}
{% endif %}{% if css %}<link rel="stylesheet" href="assets/css/pages/{{ css }}.css">
{% endif %}<script>window.BOLD_CONFIG = {{ site.firebase | dump | safe }};</script>
<script src="assets/js/bold.js"></script>
</head>
<body>
{% if emulatorWarning %}
<div id="emulatorWarning" class="emulator-warning" hidden>&#9888; FIRESTORE EMULATOR MODE &mdash; this is NOT real data. Never commit FIRESTORE_USE_EMULATOR as true.</div>
{% endif %}
{% include "partials/masthead.njk" %}
{% if not public %}{% include "partials/gate.njk" %}{% endif %}
{% include "partials/shell-open.njk" %}
{{ content | safe }}
{% if not noFooter %}{% include "partials/footer.njk" %}{% endif %}
{% include "partials/shell-close.njk" %}
{% for script in scripts %}<script src="assets/js/{{ script }}"></script>
{% endfor %}
</body>
</html>
