<!DOCTYPE html>
<html lang="en"{% if htmlClass %} class="{{ htmlClass }}"{% endif %}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script>{% include "sun.js" %}</script>
<script>/* The theme (bold.css, bold.js mountTheme): light, dark, auto (dark from sunset to sunrise, sun.js) or the lamp; set before anything paints. */ try { var t = localStorage.getItem('boldTheme'); if (t === 'auto') t = boldSunDark(Date.now()) ? 'dark' : 'light'; if (t === 'dark' || t === 'lamp') document.documentElement.setAttribute('data-theme', t); if (localStorage.getItem('boldMatrix') === '1') document.documentElement.classList.add('is-matrix'); } catch (e){}</script>
<title>{{ title | safe }}</title>
{% if description %}<meta name="description" content="{{ description | safe }}">
<meta property="og:title" content="{{ title | safe }}">
<meta property="og:description" content="{{ description | safe }}">
<meta property="og:type" content="website">
{% endif %}
{% for name in [ 'app', 'auth', 'firestore', 'functions' ] | concat(sdk or []) | concat(['functions'] if site.testMode else []) | uniq %}<script src="https://www.gstatic.com/firebasejs/{{ site.firebaseSdkVersion }}/firebase-{{ name }}-compat.js"></script>
{% endfor %}<style>@import url("assets/css/bold.css?v={{ build.stamp }}") layer(bold);</style>
{% if headExtra %}{{ headExtra | safe }}
{% endif %}{% for name in styles or [] %}<style>@import url("assets/css/{{ name }}.css?v={{ build.stamp }}") layer(bold);</style>
{% endfor %}{% if css %}<style>@import url("assets/css/pages/{{ css }}.css?v={{ build.stamp }}") layer(bold);</style>
{% endif %}<link rel="stylesheet" href="assets/css/govuk.css?v={{ build.stamp }}">
<script>window.BOLD_CONFIG = {{ site.firebase | dump | safe }}; window.BOLD_SLACK_TEAM = {{ site.slackTeam | dump | safe }}; window.BOLD_WEB_PUSH_KEY = {{ (site.webPushKey or '') | dump | safe }}; window.BOLD_FOUNDED = {{ (site.founded or '') | dump | safe }};</script>
{% if site.testMode %}<script>window.BOLD_TEST = true;</script>
{% endif %}<script src="assets/js/bold.js?v={{ build.stamp }}"></script>
{% if site.testMode %}<script src="assets/js/test-mode.js?v={{ build.stamp }}"></script>
{% endif %}
{% if not bare %}<script src="assets/js/profile-photo.js?v={{ build.stamp }}"></script>
{% endif %}
</head>
<body class="govuk-template__body">
<script>document.body.classList.add('js-enabled'); if ('noModule' in HTMLScriptElement.prototype) document.body.classList.add('govuk-frontend-supported');</script>
<a class="govuk-skip-link" href="#pageContent" data-module="govuk-skip-link">Skip to main content</a>
{% if emulatorWarning %}
<div id="emulatorWarning" class="emulator-warning" hidden>&#9888; FIRESTORE EMULATOR MODE &mdash; this is NOT real data. Never commit FIRESTORE_USE_EMULATOR as true.</div>
{% endif %}
{% if not bare %}{% include "partials/masthead.njk" %}{% endif %}
<div id="pageContent" tabindex="-1">
{% if not public %}{% include "partials/gate.njk" %}{% endif %}
{% include "partials/shell-open.njk" %}
{{ content | safe }}
{% if not noFooter and not bare %}{% include "partials/footer.njk" %}{% endif %}
{% include "partials/shell-close.njk" %}
</div>
<script src="assets/js/search-box.js?v={{ build.stamp }}"></script>
<script src="assets/js/eggs.js?v={{ build.stamp }}"></script>
{% for script in scripts %}<script src="assets/js/{{ script }}?v={{ build.stamp }}"></script>
{% endfor %}{% if not public %}<script src="assets/js/mentions.js?v={{ build.stamp }}"></script><script src="assets/js/emoji.js?v={{ build.stamp }}"></script>
{% if not ('markdown.js' in (scripts or [])) %}<script src="assets/js/markdown.js?v={{ build.stamp }}"></script>
{% endif %}<script src="assets/js/md-field.js?v={{ build.stamp }}"></script>
{% endif %}
<script type="module" src="assets/js/govuk.js?v={{ build.stamp }}"></script>
</body>
</html>
