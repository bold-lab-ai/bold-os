<div class="masthead" id="masthead"{% if hiddenChrome %} hidden{% endif %}>
  <div class="masthead-left">
    <button class="nav-toggle" id="navToggle" type="button" aria-label="Toggle navigation" aria-expanded="false" aria-controls="sidebar"{% if hiddenChrome %} hidden{% endif %}><span>&laquo;</span></button>
    <div class="masthead-brand">
      <a class="wordmark" href="index.html"><strong>BOLD</strong><span>.</span>OS</a>
      <div class="masthead-sub">Internal</div>
    </div>
  </div>
  <div class="masthead-right">{% if permalink != "index.html" %}<div class="mast-search" data-search-box hidden></div>{% endif %}<div class="mast-who"><div id="authRegion"></div><div class="mast-access" id="mastAccess" hidden></div></div></div>
</div>
<script>BOLD.mountMasthead(); (function(){ var ms = document.querySelector('.mast-search'); if (ms && BOLD.authHint()) ms.hidden = false; })();</script>
