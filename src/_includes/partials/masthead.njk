<div class="masthead" id="masthead"{% if hiddenChrome %} hidden{% endif %}>
  <div class="masthead-left">
    <button class="nav-toggle" id="navToggle" type="button" aria-label="Toggle navigation" aria-expanded="false" aria-controls="sidebar"{% if hiddenChrome %} hidden{% endif %}><span>&laquo;</span></button>
    <div class="masthead-brand">
      <a class="wordmark" href="index.html"><strong>BOLD</strong><span>.</span>OS</a>
      <div class="masthead-sub" hidden></div>
    </div>
  </div>
  <div class="masthead-right"><div class="mast-search" data-search-box hidden></div><div class="mast-create" id="mastCreate" hidden></div><div class="mast-theme-box"><button class="mast-btn mast-theme" id="themeToggle" type="button" aria-label="Theme" aria-haspopup="true" aria-expanded="false" aria-controls="themeMenu"><svg class="ic-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg><svg class="ic-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z"/></svg></button><ul class="mast-menu mast-theme-menu" id="themeMenu" role="menu" hidden></ul></div><div class="page-access" id="pageAccess" hidden></div><div class="mast-mine" id="mastMine" hidden></div><div class="mast-settings" id="mastSettings" hidden></div><div class="mast-bell" id="mastBell" hidden></div><span class="mast-sep" aria-hidden="true"></span><div id="authRegion"></div></div>
</div>
<script>BOLD.mountMasthead(); (function(){ var ms = document.querySelector('.mast-search'); if (ms && BOLD.authHint()) ms.hidden = false; })();</script>
