{%- set current = nav or (page.url | replace('/', '')) -%}
<div class="shell" id="shell"{% if public %} data-public{% endif %}{% if not public %} hidden{% endif %}>
<script>BOLD.mountShell();</script>
<button class="sidebar-backdrop" id="sidebarBackdrop" type="button" aria-label="Close navigation"></button>
<nav class="sidebar" id="sidebar" aria-label="Site navigation"{% if hiddenChrome %} hidden{% endif %}>
  <div class="sidebar-inner">
    <div class="sidebar-head">
      <span class="sidebar-title">Menu</span>
      <button class="sidebar-collapse" id="sidebarCollapse" type="button" aria-label="Collapse navigation" title="Collapse">&laquo;</button>
    </div>
    <div class="nav-groups">
{%- for group in site.nav | navState(current) %}
      <div class="nav-group"{% if group.events %} data-nav-events{% endif %}{% if group.skills %} data-nav-skills{% endif %}{% if group.guides %} data-nav-guides{% endif %}{% if group.handbook %} data-nav-handbook{% endif %}>
        <div class="nav-group-head">
          <a class="nav-group-label{% if group.active %} active{% endif %}" href="{{ group.href }}">{{ group.label }}</a>
          <button class="nav-group-toggle" type="button" aria-label="Open or close {{ group.label }}"></button>
        </div>
{%- for link in group.links %}
        <a class="nav-link nav-sub{% if link.active %} active{% endif %}" href="{{ link.href }}">{{ link.label }}</a>
{%- endfor %}
      </div>
{%- if group.separatorAfter %}
      <hr class="nav-sep">
{%- endif %}
{%- endfor %}
    </div>
  </div>
</nav>
<div class="shell-main">
