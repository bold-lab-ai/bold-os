rules_version = '2';

// MVP permission model — Sign-in-with-Slack gives identity ("who am I");
// role (junior/senior/PI/admin) comes from a hardcoded list, but NOT as
// literals in this file. The role lists live in Firestore documents
// (roles/pis, roles/admins, roles/seniors, roles/juniors — each
// {emails: [...]}), written only via the Firebase Console (never by a
// client — see the deny-all rule on roles/{roleId} below), and read here
// via get(), which bypasses that document's own rules for lookups made
// *from inside* a rule. This is deliberate: it means this file — and this
// repo, if ever made public — never contains real people's email
// addresses. See FIREBASE.md.
//
// Board/card read is sign-in-gated too, as of 2026-09-11 — this is a real
// behavior change, not a no-op: Sign-in-with-Slack is live and tested, so
// a signed-out visitor genuinely can't read the board any more. The app's
// init flow waits for the first auth-state resolution before attempting a
// load, showing a "sign in to view" state instead of a doomed fetch — see
// FIREBASE.md.
//
// Two-layer model unchanged in shape: role-list membership = eligibility
// for lab-wide actions; a card's own reviewers.junior/senior field =
// authorization for that specific card.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function email()      { return request.auth.token.email; }
    function roleList(name) {
      return get(/databases/$(database)/documents/roles/$(name)).data.emails;
    }
    function isPi()         { return isSignedIn() && email() in roleList('pis'); }
    // Admins get the same full write access as PIs (venue create/delete,
    // overriding any card) but are a separate list — not folded into
    // pis() — since "admin" and "PI" aren't the same lab role.
    function isAdmin()      { return isSignedIn() && email() in roleList('admins'); }
    function hasFullWrite() { return isPi() || isAdmin(); }
    function isSenior()     { return isSignedIn() && (email() in roleList('seniors') || isPi()); }
    function isJunior()     { return isSignedIn() && (email() in roleList('juniors') || isSenior()); }
    function isLabMember()  { return isSignedIn(); }

    // Admin-only data, never read or written by a client — only via the
    // get() calls above, and via the Firebase Console (or an Admin SDK
    // credential), both of which bypass rules entirely.
    match /roles/{roleId} {
      allow read, write: if false;
    }

    // Slack workspace roster, {name, email, slackId} per person — backs the
    // reviewer/submitter picker so it resolves to real emails instead of
    // free text (see FIREBASE.md). Read-only for clients; synced via a
    // one-off script against Slack's users.list, same admin-only-write
    // pattern as roles/{roleId}.
    match /people/{personId} {
      allow read: if isLabMember();
      allow write: if false;
    }

    match /boards/{boardId} {
      allow read: if isLabMember();
      allow create, delete, update: if hasFullWrite();

      match /cards/{cardId} {
        allow read: if isLabMember();
        allow create: if isLabMember();
        // A card can be changed only by whoever created it, a reviewer
        // assigned to it, or a PI/admin.
        allow update, delete: if isLabMember() && (
          email() == resource.data.submittedBy.email ||
          email() == resource.data.reviewers.junior ||
          email() == resource.data.reviewers.senior ||
          hasFullWrite()
        );
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
