rules_version = '2';

// Publishes each venue's .ics deadline feed at a stable, public URL — the
// same file the "Add to calendar" download button generates, regenerated
// and re-uploaded by the client whenever a venue is created/edited (see
// syncVenueIcs() in audit-board.html). Public read is the whole point (a
// subscribe URL calendar clients fetch on their own, unauthenticated); the
// write side mirrors Firestore's hasFullWrite() — only a PI/admin can edit
// a venue, so only they should be able to publish its feed. Storage rules
// can't call the Firestore functions defined in firestore.rules directly,
// so this re-reads roles/pis and roles/admins via firestore.get() — same
// underlying data, same "PI or admin" check, just spelled out again here.
service firebase.storage {
  match /b/{bucket}/o {
    match /venues/{boardId}/feed.ics {
      allow read: if true;
      // A Slack account, as firestore.rules' isSignedIn() requires.
      allow write: if request.auth != null && 'oidc.slack' in request.auth.token.firebase.identities && (
        request.auth.token.email in firestore.get(/databases/(default)/documents/roles/pis).data.emails ||
        request.auth.token.email in firestore.get(/databases/(default)/documents/roles/admins).data.emails
      );
    }
    // A board card's images (project page, a card's page; firestore.rules' work/{id}):
    // read by the lab; added and removed by whoever may change the card (its maker, whom it's
    // assigned to, the project's people, PIs and admins). Images only, 10 MB at most.
    match /work/{ws}/{card}/{file} {
      function signedIn() { return request.auth != null && 'oidc.slack' in request.auth.token.firebase.identities; }
      function mayChange() {
        let me = request.auth.token.email;
        let c = /databases/(default)/documents/projectWorkspaces/$(ws)/work/$(card);
        let w = /databases/(default)/documents/projectWorkspaces/$(ws);
        return firestore.exists(c) && (
          firestore.get(c).data.by.email == me || me in firestore.get(c).data.assigneeEmails ||
          me.lower() in firestore.get(w).data.get('members', []) ||
          me in firestore.get(/databases/(default)/documents/roles/pis).data.emails ||
          me in firestore.get(/databases/(default)/documents/roles/admins).data.emails);
      }
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(png|jpeg|gif|webp)') && mayChange();
      allow delete: if signedIn() && mayChange();
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
