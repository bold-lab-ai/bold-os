rules_version = '2';

// MVP permission model — Sign-in-with-Slack gives identity ("who am I");
// role (junior/senior/PI/admin) comes from a hardcoded list, but NOT as
// literals in this file. The role lists live in Firestore documents
// (roles/pis, roles/admins, roles/seniors, roles/juniors — each
// {emails: [...]}), written only via the Firebase Console (never by a
// client — see the deny-all rule on roles/{roleId} below), and read here
// via get(), which bypasses that document's own rules for lookups made
// *from inside* a rule. This is deliberate: it means this file — and this
// repo, if ever made public — never contains real people's email
// addresses. See FIREBASE.md.
//
// Board/card read is sign-in-gated too, as of 2026-09-11 — this is a real
// behavior change, not a no-op: Sign-in-with-Slack is live and tested, so
// a signed-out visitor genuinely can't read the board any more. The app's
// init flow waits for the first auth-state resolution before attempting a
// load, showing a "sign in to view" state instead of a doomed fetch — see
// FIREBASE.md.
//
// Two-layer model unchanged in shape: role-list membership = eligibility
// for lab-wide actions; a card's own reviewers.junior/senior field =
// authorization for that specific card.

service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in to a Slack account: membership of the BOLD Slack is what makes
    // someone a lab member. Checked by the account's identities, not the
    // session's sign_in_provider, which linking GitHub turns into github.com.
    // Only Slack accounts can be created (onlySlackSignUps), so another
    // provider can't reach anything on its own; functions/index.js
    // (signedInEmail) holds to the same.
    function isSignedIn() {
      return request.auth != null && 'oidc.slack' in request.auth.token.firebase.identities;
    }
    function email()      { return request.auth.token.email; }
    function roleList(name) {
      return get(/databases/$(database)/documents/roles/$(name)).data.emails;
    }
    function isPi()         { return isSignedIn() && email() in roleList('pis'); }
    // Admins get the same full write access as PIs (venue create/delete,
    // overriding any card) but are a separate list — not folded into
    // pis() — since "admin" and "PI" aren't the same lab role.
    function isAdmin()      { return isSignedIn() && email() in roleList('admins'); }
    function hasFullWrite() { return isPi() || isAdmin(); }
    function isSenior()     { return isSignedIn() && (email() in roleList('seniors') || isPi()); }
    function isJunior()     { return isSignedIn() && (email() in roleList('juniors') || isSenior()); }
    function isLabMember()  { return isSignedIn(); }

    // Who can see what (BOLDiquette › People › Who can see what; functions/access.js):
    // for each page, the lowest group of Who is BOLD that may view it ('view') and edit it
    // ('edit': directly, or by proposing and commenting where changes are reviewed), in
    // settings/access (written only by decideProposal, from the BOLDiquette's table). A
    // group is a member's `category` (only PIs and admins set it); without one, PAN-BOLD,
    // the same as Everyone (everyone signed in). Not signed in, nothing. PIs and admins count as
    // BOLD-exec. A page missing from the table is BOLD-internal. may() is on top of each
    // rule's own conditions, which still apply.
    function levelRank(level) {
      return {'everyone': 1, 'pan': 1, 'associate': 2, 'internal': 3, 'staff': 4, 'exec': 5, 'none': 6}.get(level, 3);
    }
    function myRank() { return isSignedIn() ? memberRank() : 0; }
    function memberRank() {
      let m = get(/databases/$(database)/documents/members/$(email().lower()));
      return hasFullWrite() ? 5
        : m == null ? 1
        : {'pan': 1, 'associate': 2, 'internal': 3, 'staff': 4, 'exec': 5}.get(m.data.get('category', 'pan'), 1);
    }
    function level(page, what) {
      let a = get(/databases/$(database)/documents/settings/access);
      return a == null ? 'internal' : a.data.get('pages', {}).get(page, {}).get(what, 'internal');
    }
    function need(page, what) { return myRank() >= levelRank(level(page, what)); }
    // Signed in (with Slack) and allowed by the table.
    function may(page, what)   { return isSignedIn() && need(page, what); }

    // Admin-only data, never read or written by a client — only via the
    // get() calls above, and via the Firebase Console (or an Admin SDK
    // credential), both of which bypass rules entirely.
    match /roles/{roleId} {
      allow read, write: if false;
    }

    // Slack workspace roster, {name, email, slackId} per person — backs the
    // reviewer/submitter picker so it resolves to real emails instead of
    // free text (see FIREBASE.md). Read-only for clients; synced via a
    // one-off script against Slack's users.list, same admin-only-write
    // pattern as roles/{roleId}.
    match /people/{personId} {
      // Names on a project's page too.
      allow read: if may('people', 'view') || may('projects', 'view');
      allow write: if false;
    }

    // Joining BOLD (functions/index.js "Joining BOLD"): requests come in through
    // requestToJoin and are decided through decideJoinRequest, so clients write
    // neither; PIs and admins read them (join-requests.html).
    match /joinRequests/{id} {
      // PIs and admins; and whoever the applicant named as inviting them (to confirm it).
      allow read: if hasFullWrite() || (isLabMember() && resource.data.get('invitedBy', {}).get('email', '') == email().lower());
      allow write: if false;
    }
    // Each member's record (members/{email, lowercase}): made on approval from what
    // they asked with, or by them on their profile; theirs to edit, but not who approved
    // it or their category.
    match /members/{memberEmail} {
      // Your own always (your profile); others' with People, or on a project's page.
      allow read: if isSignedIn() && (email().lower() == memberEmail || may('people', 'view') || may('projects', 'view'));
      allow create, update: if may('profile', 'edit') && email().lower() == memberEmail
        && request.resource.data.email == memberEmail
        && request.resource.data.keys().hasOnly(['name', 'email', 'links', 'institution', 'role', 'contact', 'contactEmail', 'interests', 'pillars', 'listOnWebsite', 'basedIn', 'pronouns', 'feedback', 'bookingUrl', 'startDate', 'endDate', 'updatedAt', 'requestId', 'approvedBy', 'approvedAt', 'category', 'categoryBy', 'categoryAt', 'invitedBy'])
        && (resource == null
          ? !('approvedBy' in request.resource.data) && !('requestId' in request.resource.data) && !('approvedAt' in request.resource.data) && !('category' in request.resource.data) && !('invitedBy' in request.resource.data)
          : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'links', 'institution', 'role', 'contact', 'contactEmail', 'interests', 'pillars', 'listOnWebsite', 'basedIn', 'pronouns', 'feedback', 'bookingUrl', 'startDate', 'endDate', 'updatedAt']))
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.get('links', '').size() <= 500 && request.resource.data.get('interests', '').size() <= 300
        && request.resource.data.get('pillars', []) is list && request.resource.data.get('pillars', []).size() <= 20
        && request.resource.data.get('pronouns', '') is string && request.resource.data.get('pronouns', '').size() <= 40
        && request.resource.data.get('contactEmail', '') is string && request.resource.data.get('contactEmail', '').size() <= 200
        && request.resource.data.get('bookingUrl', '') is string && request.resource.data.get('bookingUrl', '').size() <= 300
        && request.resource.data.get('feedback', '') in ['', 'direct', 'balanced', 'gentle'];
      // Which of the BOLDiquette's groups they're in (Who is BOLD): set by PIs and admins
      // on the People page, never by the member.
      allow update: if hasFullWrite()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['category', 'categoryBy', 'categoryAt'])
        && request.resource.data.category in ['exec', 'internal', 'associate', 'staff', 'pan']
        && request.resource.data.categoryBy == email();
      allow delete: if false;
    }
    // Recommendation letters (letters.html; functions/index.js "Service desk"):
    // only whoever asked and whoever writes it read a request; every write goes
    // through letterRequest, which tells the other one on Slack.
    match /letterRequests/{id} {
      allow read: if may('service-desk', 'view') && (resource.data.requesterEmail == email().lower() || resource.data.writerEmail == email().lower());
      allow write: if false;
    }
    // Introductions (introductions.html): offers, by anyone, read by the lab, changed
    // by whoever made them (removed by a PI or admin too); requests on them, read by
    // the two people only, every write through introRequest.
    match /introOffers/{id} {
      allow read: if may('service-desk', 'view');
      allow create: if may('service-desk', 'edit') && request.resource.data.keys().hasOnly(['org', 'area', 'by', 'at', 'updatedAt'])
        && request.resource.data.by.email == email().lower() && request.resource.data.by.name is string
        && request.resource.data.org is string && request.resource.data.org.size() > 0 && request.resource.data.org.size() <= 120
        && request.resource.data.area is string && request.resource.data.area.size() <= 300
        && request.resource.data.at is number && request.resource.data.updatedAt is number;
      allow update: if may('service-desk', 'edit') && resource.data.by.email == email().lower()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['org', 'area', 'updatedAt'])
        && request.resource.data.org is string && request.resource.data.org.size() > 0 && request.resource.data.org.size() <= 120
        && request.resource.data.area is string && request.resource.data.area.size() <= 300
        && request.resource.data.updatedAt is number;
      allow delete: if may('service-desk', 'edit') && (resource.data.by.email == email().lower() || hasFullWrite());
    }
    match /introRequests/{id} {
      allow read: if may('service-desk', 'view') && (resource.data.requesterEmail == email().lower() || resource.data.offererEmail == email().lower());
      allow write: if false;
    }
    // The join form's choices (join.html, read before signing in) and, for PIs and
    // admins only, the Slack invite link and the welcome email's text.
    match /settings/joinForm {
      allow read: if true;
      allow write: if hasFullWrite() && request.resource.data.keys().hasOnly(['roles', 'pillars', 'updatedAt', 'updatedBy'])
        && request.resource.data.roles is list && request.resource.data.roles.size() <= 30
        && request.resource.data.pillars is list && request.resource.data.pillars.size() <= 20;
    }
    // Each group's Slack channels, and each role's (roleChannels) (functions/index.js "Groups"):
    // the lab reads them; PIs and admins set them on Join requests. channelErrors and
    // roleChannelErrors are the server's.
    match /settings/groups {
      allow read: if may('people', 'view');
      allow write: if hasFullWrite() && request.resource.data.keys().hasOnly(['channels', 'roleChannels', 'updatedAt', 'updatedBy'])
        && request.resource.data.channels is map && request.resource.data.channels.keys().hasOnly(['exec', 'internal', 'associate', 'staff'])
        && request.resource.data.get('roleChannels', {}) is map && request.resource.data.get('roleChannels', {}).size() <= 30;
    }
    // Pilots (functions/index.js pilotSlack): a new Slack feature reaches only its testers
    // until a PI or admin switches it live (Requests › Settings › Pilots). `known` (the
    // features, with their names) is the server's; PIs and admins set testers and live.
    match /settings/pilot {
      allow read: if hasFullWrite();
      // testers: every pilot's; pilotTesters: { feature: [emails] }, one pilot's besides.
      allow write: if hasFullWrite() && request.resource.data.keys().hasOnly(['testers', 'pilotTesters', 'live', 'known', 'updatedAt', 'updatedBy'])
        && request.resource.data.get('pilotTesters', {}) is map && request.resource.data.get('pilotTesters', {}).size() <= 50
        && request.resource.data.get('known', {}) == (resource == null ? {} : resource.data.get('known', {}))
        && request.resource.data.get('testers', []) is list && request.resource.data.get('testers', []).size() <= 20
        && request.resource.data.get('live', {}) is map && request.resource.data.updatedBy == email();
    }
    // Who did what with whom (functions/index.js "Interactions"): the lab reads them, for
    // Connections on a profile and the Network page; only the server writes them.
    match /interactions/{id} {
      allow read: if may('people', 'view');
      allow write: if false;
    }
    // Requests to be in another group: theirs to read, and the PIs' and admins'; all writes
    // through groupRequest.
    match /groupRequests/{id} {
      // PIs and admins; who asked; and whoever invited them, who decides it (groupRequest).
      allow read: if hasFullWrite() || (isLabMember() && (resource.data.email == email().lower() || resource.data.get('inviterEmail', '') == email().lower()));
      allow write: if false;
    }

    // Requests to join a student's supervision meeting (studyRequest in functions/index.js):
    // whoever asked and the student read them; no client writes.
    match /studyRequests/{id} {
      allow read: if may('calendar', 'view') && (resource.data.email == email().lower() || resource.data.student == email().lower());
      allow write: if false;
    }

    // Who can see what: the BOLDiquette's table, as the site enforces it. Everyone signed in
    // reads it (the pages show what's for whom); only decideProposal writes it.
    match /settings/access {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /settings/joinInvite {
      allow read: if hasFullWrite();
      allow write: if hasFullWrite() && request.resource.data.keys().hasOnly(['slackInviteUrl', 'slackInviteExpires', 'subject', 'body', 'updatedAt', 'updatedBy'])
        && request.resource.data.get('slackInviteUrl', '').size() <= 300
        && request.resource.data.get('slackInviteExpires', '') is string && request.resource.data.get('slackInviteExpires', '').size() <= 10
        && request.resource.data.get('subject', '').size() <= 200 && request.resource.data.get('body', '').size() <= 5000;
    }

    match /boards/{boardId} {
      // A venue is either 'approved' (visible to the whole lab, same as
      // always) or 'pending' (a non-admin's proposal — visible only to
      // whoever proposed it and to a PI/admin, until approved). Missing
      // `status` entirely means an approved venue — every board created
      // before this field existed defaults to 'approved' via get()'s
      // fallback, so old data needs no migration for single-document
      // reads. List queries are a separate story (get()'s default can't
      // help a `where('status','==',...)` filter match a field that
      // literally isn't there) — see the client-side note in
      // docs/FIREBASE.md before deploying this against boards created
      // pre-2026-09-11.
      // A project's page shows its venue.
      allow read: if (may('ml-cycle', 'view') || may('projects', 'view')) && (
        resource.data.get('status', 'approved') != 'pending' ||
        hasFullWrite() ||
        (('proposedBy' in resource.data) && email() == resource.data.proposedBy.email)
      );
      // Direct creation (status 'approved', or omitted) stays PI/admin
      // only, same as before. A signed-in lab member who isn't PI/admin
      // can still create a board doc, but only as a self-attributed
      // pending proposal — the client always tries the direct-approved
      // create first (see onCreateBoard) and only falls back to this on
      // a permission-denied, so this branch is never the first attempt
      // for someone who could've just created it outright.
      allow create: if may('ml-cycle', 'edit') && (
        hasFullWrite() ||
        (request.resource.data.status == 'pending' && request.resource.data.proposedBy.email == email())
      );
      // Approving a proposal (flipping status to 'approved') is just
      // another update, so it needs no separate rule — same as editing
      // or deleting any venue, still PI/admin only. A proposer can't
      // edit or withdraw their own pending proposal once submitted;
      // ask a PI/admin to approve or delete it.
      allow update, delete: if hasFullWrite();

      // A paper on the board is also a project (project.html#board=…).
      match /cards/{cardId} {
        allow read: if may('ml-cycle', 'view') || may('projects', 'view');
        // Only the server (projectWorkspace 'submit') files a card under another
        // card's project (`projectId`); nobody changes it afterwards.
        allow create: if (may('ml-cycle', 'edit') || may('projects', 'edit')) && request.resource.data.get('projectId', cardId) == cardId;
        // A card can be changed only by whoever created it, a reviewer
        // assigned to it, or a PI/admin — same base condition as before.
        //
        // Reassigning reviewers is narrower (2026-09-11): the `reviewers`
        // field specifically may only change if the writer is the
        // submitter or a PI/admin — an assigned reviewer can still edit
        // everything else on their own card (checklist, review state,
        // discussion, status) via the base condition above, but can't
        // reassign reviewers, including moving themselves off a card or
        // someone else onto one. Compares the whole `reviewers` map for
        // equality rather than diffing individual keys — simpler, and
        // sufficient since the client only ever rewrites that map as a
        // whole (onSetReviewer).
        allow update: if (may('ml-cycle', 'edit') || may('projects', 'edit')) && (
          email() == resource.data.submittedBy.email ||
          email() in resource.data.get('authorEmails', []) ||
          email() == resource.data.reviewers.junior ||
          email() == resource.data.reviewers.senior ||
          hasFullWrite()
        ) && (
          request.resource.data.reviewers == resource.data.reviewers ||
          email() == resource.data.submittedBy.email ||
          hasFullWrite()
        ) && request.resource.data.get('projectId', '') == resource.data.get('projectId', '');
        allow delete: if (may('ml-cycle', 'edit') || may('projects', 'edit')) && (
          email() == resource.data.submittedBy.email ||
          email() == resource.data.reviewers.junior ||
          email() == resource.data.reviewers.senior ||
          hasFullWrite()
        );
      }
    }

    // Projects registered without a venue yet (Projects page). Each document is
    // a card in exactly the shape boards/{boardId}/cards/{cardId} holds (built by
    // makeRegisteredCard in src/assets/js/card-model.js); "set a venue" moves it
    // into that board's cards and deletes it here. Readable by the lab, created
    // only as yourself, edited by its submitter, one of its authors (authorEmails,
    // as on a project's page) or a PI/admin, deleted or moved only by its
    // submitter or a PI/admin.
    match /projects/{projectId} {
      allow read: if may('projects', 'view');
      allow create: if may('projects', 'edit') && request.resource.data.submittedBy.email == email() &&
        request.resource.data.get('projectId', projectId) == projectId;
      allow update: if may('projects', 'edit') && (
        email() == resource.data.submittedBy.email ||
        email() in resource.data.get('authorEmails', []) ||
        hasFullWrite()
      ) && request.resource.data.get('projectId', '') == resource.data.get('projectId', '');
      allow delete: if may('projects', 'edit') && (
        email() == resource.data.submittedBy.email || hasFullWrite()
      );
    }

    // Each project's meeting, slides, notes and members (projectWorkspaces/{card id}),
    // written only by the functions (projectWorkspace, onProjectWritten,
    // onVenueCardWritten); the lab reads them for the project and meetings pages.
    // Its presentations (projectWorkspaces/{card id}/presentations): the lab reads
    // them; the project's members (the workspace's `members`, lowercase) and
    // PIs/admins add, change and remove them; whoever added one can remove it.
    // Presentations across projects: a talk's and a session's page list the ones
    // given there (collectionGroup('presentations')), to link their projects.
    // These match every such document wherever it is, and rules add up: each is no
    // more open than the page that lists them, nor than the least open place they're in.
    match /{path=**}/presentations/{id} {
      allow read: if may('projects', 'view');
    }
    // Every proposal on one page (tools.html lists the proposed new tools; collectionGroup).
    match /{path=**}/proposals/{id} {
      allow read: if may('tools', 'view') && may('skills', 'view') && may('guides', 'view');
    }
    // Every comment thread on one page (comments.html, collectionGroup): the guides'
    // and the BOLDiquette's comments and the board's cards.
    match /{path=**}/comments/{id} {
      allow read: if may('guides', 'view') && may('ml-cycle', 'view');
    }
    match /{path=**}/cards/{id} {
      allow read: if may('ml-cycle', 'view') || may('projects', 'view');
    }

    // A PhD or Master student's studies (studies/{email}): working title, the people
    // involved and their recurring meeting; written only by the `studies` function.
    // Their own always (their profile); others' with the Calendar.
    match /studies/{studentEmail} {
      allow read: if isSignedIn() && (email().lower() == studentEmail || may('calendar', 'view'));
      allow write: if false;
    }

    match /projectWorkspaces/{cardId} {
      allow read: if may('projects', 'view');
      allow write: if false;

      function isProjectMember() {
        let ws = /databases/$(database)/documents/projectWorkspaces/$(cardId);
        return exists(ws) && email().lower() in get(ws).data.get('members', []);
      }
      function validPresentation(d) {
        return d.keys().hasOnly(['title', 'type', 'date', 'presenter', 'occasion', 'slidesUrl', 'recordingUrl', 'by', 'at']) &&
          d.get('type', '') in ['', 'research-talk', 'pitch', 'keynote'] &&
          d.title is string && d.title.size() > 0 && d.title.size() <= 200 &&
          d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') &&
          d.presenter is string && d.presenter.size() <= 200 &&
          // Where it was given: one of the site's events, a venue on the board, or named.
          d.occasion is map && d.occasion.keys().hasOnly(['kind', 'id', 'label', 'sessionSlug', 'sessionTitle', 'talkSlug', 'talkTitle']) &&
          d.occasion.get('sessionSlug', '') is string && d.occasion.get('sessionTitle', '') is string &&
          d.occasion.get('talkSlug', '') is string && d.occasion.get('talkTitle', '') is string &&
          d.occasion.kind in ['event', 'venue', 'other'] &&
          d.occasion.id is string && d.occasion.id.size() <= 200 &&
          d.occasion.label is string && d.occasion.label.size() > 0 && d.occasion.label.size() <= 200 &&
          d.slidesUrl is string && d.slidesUrl.size() <= 2000 &&
          d.recordingUrl is string && d.recordingUrl.size() <= 2000;
      }
      match /presentations/{id} {
        allow read: if may('projects', 'view');
        allow create: if may('projects', 'edit') && (isProjectMember() || hasFullWrite()) &&
          request.resource.data.by.email == email() && validPresentation(request.resource.data);
        allow update: if may('projects', 'edit') && (isProjectMember() || hasFullWrite()) &&
          request.resource.data.by == resource.data.by && validPresentation(request.resource.data);
        allow delete: if may('projects', 'edit') && (isProjectMember() || hasFullWrite() || resource.data.by.email == email());
      }

      // Its work board's cards (project page, Work tab; projectWork adds GitHub and the
      // site's proposals). Anyone with Projects' Edit adds one to a board that's on, even
      // if they aren't on the project; whoever made it and whom it's assigned to change
      // and move it; the project's people, PIs and admins change or remove any.
      function boardOn() {
        let ws = /databases/$(database)/documents/projectWorkspaces/$(cardId);
        return exists(ws) && get(ws).data.get('work', {}).get('on', false) == true;
      }
      function validWork(d) {
        // announce: false when whoever added it chose not to post it in the project's channel;
        // doneQuiet: true when whoever moved it to Done chose not to tell whoever raised it.
        return d.keys().hasOnly(['title', 'notes', 'kind', 'column', 'assignees', 'assigneeEmails', 'links', 'images', 'announce', 'doneQuiet', 'by', 'at', 'updatedAt', 'updatedBy', 'movedAt']) &&
          d.get('announce', true) is bool && d.get('doneQuiet', false) is bool &&
          d.title is string && d.title.size() > 0 && d.title.size() <= 200 &&
          d.get('kind', '') in ['', 'code', 'content', 'request', 'other'] &&
          // notes: its description (Markdown, on its page); images: [{ path, url, name, by, at }]
          // in Storage (storage.rules, work/…), shown only from there.
          d.notes is string && d.notes.size() <= 20000 &&
          d.get('images', []) is list && d.get('images', []).size() <= 20 &&
          d.column in ['todo', 'doing', 'review', 'done'] &&
          d.assignees is list && d.assignees.size() <= 10 &&
          d.assigneeEmails is list && d.assigneeEmails.size() == d.assignees.size() &&
          d.links is list && d.links.size() <= 10 &&
          d.at is number && d.updatedAt is number && d.movedAt is number && d.updatedBy == email();
      }
      match /work/{id} {
        allow read: if may('projects', 'view');
        allow create: if may('projects', 'edit') && boardOn() &&
          request.resource.data.by.email == email() && validWork(request.resource.data);
        allow update: if may('projects', 'edit') &&
          (isProjectMember() || hasFullWrite() || resource.data.by.email == email() || email() in resource.data.assigneeEmails) &&
          request.resource.data.by == resource.data.by && request.resource.data.at == resource.data.at && validWork(request.resource.data);
        allow delete: if may('projects', 'edit') && (isProjectMember() || hasFullWrite() || resource.data.by.email == email());

        // Its conversation (card-talk.js): whoever sees the board reads it and comments, as
        // themselves; the author edits their text; the author, a PI or an admin deletes one.
        // { text, by: { email, name }, at, editedAt? }; onCardCommented tells the card's people.
        function validTalk(d) {
          return d.keys().hasOnly(['text', 'by', 'at', 'editedAt']) &&
            d.text is string && d.text.size() > 0 && d.text.size() <= 2000 &&
            d.by is map && d.by.keys().hasOnly(['email', 'name']) && d.by.name is string && d.at is number;
        }
        match /comments/{cid} {
          allow read: if may('projects', 'view');
          allow create: if may('projects', 'view') && exists(/databases/$(database)/documents/projectWorkspaces/$(cardId)/work/$(id)) &&
            request.resource.data.by.email == email() && !('editedAt' in request.resource.data) && validTalk(request.resource.data);
          allow update: if resource.data.by.email == email() && request.resource.data.by == resource.data.by &&
            request.resource.data.at == resource.data.at && request.resource.data.editedAt is number && validTalk(request.resource.data);
          allow delete: if resource.data.by.email == email() || hasFullWrite();
        }
      }
    }

    // BOLD Collaboration Week workshop proposals (2026-09-15) — a separate
    // top-level collection, not nested under boards/{boardId}: a proposal
    // isn't a venue or a paper, it's its own flow entirely (see
    // event-collaboration-week.html). Same isLabMember()/hasFullWrite()
    // helpers as boards/cards above. Any signed-in lab member can read
    // every proposal (see the whole list) and create their own
    // (self-attributed — the email on the document must be their own,
    // same pattern as a pending board proposal above); only the proposer
    // themselves or a PI/admin can edit or withdraw it afterward.
    // Each is for one occurrence (eventSlug), proposed only while its call is open
    // (events/{slug}.proposalsOpen, opened and closed on its page by its organisers, PIs
    // and admins), and stays with it.
    match /collabWeekProposals/{proposalId} {
      allow read: if may('events', 'view');
      allow create: if may('events', 'edit') && request.resource.data.email == email()
        && request.resource.data.eventSlug is string
        && get(/databases/$(database)/documents/events/$(request.resource.data.eventSlug)).data.get('proposalsOpen', false) == true;
      allow update: if may('events', 'edit') && (email() == resource.data.email || hasFullWrite())
        && request.resource.data.get('eventSlug', '') == resource.data.get('eventSlug', '');
      allow delete: if may('events', 'edit') && (email() == resource.data.email || hasFullWrite());
    }

    // Every event's sessions (Collaboration Week's, the Festival's…), keyed
    // by slug: all of a session — its event (eventSlug), its leads ({name,
    // email} records, plus leadEmails: every address they may sign in with,
    // lowercased) and the rest. Its day and time are its event's time slot's
    // (events/{eventSlug}.days). A PI/admin creates it and can change
    // anything (incl. `removed`, which takes a session off the schedule) or
    // delete it; a lead can edit their session's fields but not who the
    // leads are, nor its event, type or venue.
    match /collabWeekSessions/{slug} {
      allow read: if may('events', 'view');
      allow create, delete: if hasFullWrite();
      allow update: if hasFullWrite() || (
        may('events', 'edit') && email().lower() in resource.data.leadEmails &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['leads', 'leadEmails', 'slug', 'added', 'removed', 'day', 'date', 'time', 'locationSlug', 'type', 'eventSlug'])
      );
    }

    // Every session's talks, keyed by slug, each naming its session
    // (sessionSlug). Written only by the editTalk and createTalk functions
    // (functions/index.js), which check the caller's email is a presenter's,
    // a session lead's or a PI/admin's.
    match /collabWeekTalks/{slug} {
      allow read: if may('events', 'view');
      allow write: if false;
    }

    // Events added from the events page (src/assets/js/events-common.js),
    // keyed by their slug; the built-in events are static pages. Adding one is for the
    // table's Edit (BOLDiquette › Who can see what); it starts hidden, and whoever added it
    // releases it. A hidden one is for PIs/admins and whoever added it — everyone else
    // queries where('hidden', '==', false), and their own by createdBy. Whoever added it
    // edits, releases, hides and deletes it, and chooses who Google invites (the page warns
    // what releasing sets off). An edition of a recurring event (`series`, eventSeries/{id})
    // is its organisers' too. PIs and admins can do all of it.
    match /events/{slug} {
      function addedByMe(d) { return d.get('createdBy', '') == email(); }
      function organisesIt(d) {
        let id = d.get('series', '');
        return id != '' && exists(/databases/$(database)/documents/eventSeries/$(id))
          && email().lower() in get(/databases/$(database)/documents/eventSeries/$(id)).data.get('organisers', []);
      }
      function mine(d) { return addedByMe(d) || organisesIt(d); }
      allow read: if may('events', 'view') && (resource.data.hidden == false || hasFullWrite() || mine(resource.data));
      allow create: if hasFullWrite() || (may('events', 'edit') && request.resource.data.hidden == true && addedByMe(request.resource.data)
        && request.resource.data.get('series', '') == ''
        && request.resource.data.get('inviteGroup', 'none') in ['none', 'everyone', 'associate', 'internal', 'staff', 'exec']);
      allow update: if hasFullWrite() || (may('events', 'edit') && mine(resource.data)
        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
        && request.resource.data.get('series', '') == resource.data.get('series', '')
        && request.resource.data.hidden is bool
        && request.resource.data.get('inviteGroup', 'none') in ['none', 'everyone', 'associate', 'internal', 'staff', 'exec']);
      allow delete: if hasFullWrite() || (may('events', 'edit') && mine(resource.data));
    }

    // Recurring lab meetings (eventSeries/{id}; functions/series.js), written only by the
    // eventSeries function: the released ones for whoever can view Events, a hidden one
    // for PIs and admins and its organisers.
    // An occurrence's Google Calendar invitation (functions/series.js syncOccurrence): its page
    // shows when it couldn't be sent. Only the server writes it.
    match /eventInvites/{slug} {
      allow read: if may('events', 'view');
      allow write: if false;
    }
    match /eventSeries/{id} {
      allow read: if may('events', 'view') && (resource.data.hidden == false || hasFullWrite() || email().lower() in resource.data.get('organisers', []));
      allow write: if false;
    }

    // Claude skills (skills/{name}; see skillPackage in functions/index.js).
    // Public anyway — anyone can download one — so any lab member reads them;
    // only PIs/admins add or delete them (and restore an earlier version). A change
    // to one is proposed, as for the guides, by anyone (proposals/{id}, kind 'skill':
    // { before, after } its title, description, body and files), and another PI or
    // admin accepts it (decideProposal).
    match /skills/{name} {
      allow read: if may('skills', 'view');
      // updatedBy is who the version history (functions/index.js) credits.
      allow create, update: if hasFullWrite() && request.resource.data.name == name
        && request.resource.data.updatedBy == email();
      allow delete: if hasFullWrite();
      // Its history, written only by the historySkills function.
      match /versions/{version} {
        allow read: if may('skills', 'view');
        allow write: if false;
      }
      match /proposals/{id} {
        allow read: if may('skills', 'view');
        // kind 'new': a new skill (this one doesn't exist yet), made when accepted.
        allow create: if may('skills', 'edit') && request.resource.data.by.email == email()
          && request.resource.data.status == 'open' && request.resource.data.kind in ['skill', 'new']
          && request.resource.data.keys().hasOnly(['kind', 'before', 'after', 'note', 'by', 'at', 'status'])
          && request.resource.data.after is map && request.resource.data.after.keys().hasOnly(['title', 'description', 'body', 'files']);
        // Edited by whoever proposed it, while it's open; who, when and its status stay.
        allow update: if may('skills', 'edit') && resource.data.by.email == email() && resource.data.status == 'open'
          && request.resource.data.status == 'open' && request.resource.data.by == resource.data.by && request.resource.data.at == resource.data.at
          && request.resource.data.editedAt is number && request.resource.data.kind == resource.data.kind
          && request.resource.data.keys().hasOnly(['kind', 'before', 'after', 'note', 'by', 'at', 'status', 'editedAt'])
          && request.resource.data.after is map && request.resource.data.after.keys().hasOnly(['title', 'description', 'body', 'files']);
        // Withdrawn by whoever proposed it, while it's open.
        allow delete: if may('skills', 'edit') && resource.data.by.email == email() && resource.data.status == 'open';
      }
    }

    // The tools the lab adds for agents (agentTools/{name}; functions/api-tools.js, the
    // Tools pages). Read by the lab; written only when a proposal is accepted
    // (decideProposal), or by a PI or admin restoring an earlier version. A proposal
    // (proposals/{id}, kind 'new' | 'tool' | 'delete': { after: { title, description,
    // acting, input, code } }) is made by anyone, edited or withdrawn by them while
    // open; `review` is the reviewer's (functions/reviewer.js), which they can't touch.
    match /agentTools/{name} {
      allow read: if may('tools', 'view');
      allow update: if hasFullWrite() && request.resource.data.name == name && request.resource.data.updatedBy == email();
      allow create, delete: if false;
      match /versions/{version} {
        allow read: if may('tools', 'view');
        allow write: if false;
      }
      match /proposals/{id} {
        allow read: if may('tools', 'view');
        allow create: if may('tools', 'edit') && request.resource.data.by.email == email()
          && request.resource.data.status == 'open' && request.resource.data.kind in ['new', 'tool', 'delete']
          && request.resource.data.keys().hasOnly(['kind', 'before', 'after', 'note', 'by', 'at', 'status'])
          && (request.resource.data.kind == 'delete' || (request.resource.data.after is map
            && request.resource.data.after.keys().hasOnly(['title', 'description', 'acting', 'input', 'code'])));
        allow update: if may('tools', 'edit') && resource.data.by.email == email() && resource.data.status == 'open'
          && request.resource.data.status == 'open' && request.resource.data.by == resource.data.by && request.resource.data.at == resource.data.at
          && request.resource.data.editedAt is number && request.resource.data.kind == resource.data.kind
          && request.resource.data.get('review', null) == resource.data.get('review', null)
          && request.resource.data.keys().hasOnly(['kind', 'before', 'after', 'note', 'by', 'at', 'status', 'editedAt', 'review'])
          && (request.resource.data.kind == 'delete' || (request.resource.data.after is map
            && request.resource.data.after.keys().hasOnly(['title', 'description', 'acting', 'input', 'code'])));
        allow delete: if may('tools', 'edit') && resource.data.by.email == email() && resource.data.status == 'open';
      }
    }

    // How-to guides (guides/{slug}; see src/assets/js/guides-common.js).
    // Everyone, PIs and admins too, proposes a change (proposals/{id}, as
    // themselves, open), which a PI/admin other than whoever proposed it
    // accepts or declines through the decideProposal function, the only writer
    // of a guide's content and of a proposal's status; whoever proposed it can
    // edit or withdraw it while it's open. PIs/admins add a guide (empty) and delete one.
    match /guides/{slug} {
      // Its page in Who can see what: Get started sits on the Service desk (bold.js BOLD.GUIDE_AREAS).
      function guideArea(slug){ return slug == 'get-started-at-bold' ? 'get-started' : 'guides'; }
      allow read: if may(guideArea(slug), 'view');
      // updatedBy is who the version history (functions/index.js) credits.
      allow create: if hasFullWrite() && request.resource.data.slug == slug
        && request.resource.data.updatedBy == email() && request.resource.data.parts.size() == 0;
      // Only who's about to delete it (pages/guide.js stamps that first).
      allow update: if hasFullWrite() && request.resource.data.updatedBy == email()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'updatedBy', 'changeNote', 'proposedBy']);
      allow delete: if hasFullWrite();
      // Its history, written only by the historyGuides function.
      match /versions/{version} {
        allow read: if may(guideArea(slug), 'view');
        allow write: if false;
      }
      // Comments on selected text (comments.js): the lab reads and comments as
      // themselves; the author edits their text; the author or a PI/admin resolves or
      // deletes it; whoever started a thread can delete its replies with it.
      match /comments/{id} {
        allow read: if may(guideArea(slug), 'view');
        allow create: if may(guideArea(slug), 'edit') && request.resource.data.by.email == email()
          && request.resource.data.keys().hasOnly(['partId', 'quote', 'prefix', 'suffix', 'text', 'by', 'at', 'parent', 'proposalId'])
          && request.resource.data.partId is string && request.resource.data.at is number
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && ('parent' in request.resource.data
            ? request.resource.data.parent is string && exists(/databases/$(database)/documents/guides/$(slug)/comments/$(request.resource.data.parent))
            // On a proposed change: its discussion.
            : 'proposalId' in request.resource.data
            ? request.resource.data.proposalId is string && exists(/databases/$(database)/documents/guides/$(slug)/proposals/$(request.resource.data.proposalId))
            : request.resource.data.quote is string && request.resource.data.quote.size() > 0 && request.resource.data.quote.size() <= 500);
        allow update: if may(guideArea(slug), 'edit') && (
          (resource.data.by.email == email() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
            && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
            && (!('editedAt' in request.resource.data) || request.resource.data.editedAt is number))
          || ((resource.data.by.email == email() || hasFullWrite())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved', 'resolvedBy', 'resolvedByName', 'resolvedAt'])
            && request.resource.data.resolvedBy == email()));
        allow delete: if may(guideArea(slug), 'edit') && (resource.data.by.email == email() || hasFullWrite()
          || ('parent' in resource.data && resource.data.parent is string
            && get(/databases/$(database)/documents/guides/$(slug)/comments/$(resource.data.parent)).data.by.email == email()));
      }
      match /proposals/{id} {
        allow read: if may(guideArea(slug), 'view');
        allow create: if may(guideArea(slug), 'edit') && request.resource.data.by.email == email()
          && request.resource.data.status == 'open'
          && request.resource.data.kind in ['about', 'edit', 'add', 'remove', 'move', 'restore', 'batch']
          && request.resource.data.keys().hasOnly(['kind', 'partId', 'before', 'after', 'note', 'by', 'at', 'status', 'changes'])
          // Several changes proposed together (a draft): a list of them, as single proposals.
          && (request.resource.data.kind == 'batch'
            ? request.resource.data.changes is list && request.resource.data.changes.size() > 0 && request.resource.data.changes.size() <= 50
            : !('changes' in request.resource.data));
        // Edited by whoever proposed it, while it's open: its changes and note, as when
        // proposed; who, when and its status stay as they were.
        allow update: if may(guideArea(slug), 'edit') && resource.data.by.email == email() && resource.data.status == 'open'
          && request.resource.data.status == 'open' && request.resource.data.by == resource.data.by && request.resource.data.at == resource.data.at
          && request.resource.data.editedAt is number
          && request.resource.data.kind in ['about', 'edit', 'add', 'remove', 'move', 'batch']
          && request.resource.data.keys().hasOnly(['kind', 'partId', 'before', 'after', 'note', 'by', 'at', 'status', 'changes', 'editedAt'])
          && (request.resource.data.kind == 'batch'
            ? request.resource.data.changes is list && request.resource.data.changes.size() > 0 && request.resource.data.changes.size() <= 50
            : !('changes' in request.resource.data));
        // Withdrawn by whoever proposed it while it's open, or with its guide.
        allow delete: if hasFullWrite() || (may(guideArea(slug), 'edit') && resource.data.by.email == email() && resource.data.status == 'open');
      }
    }

    // The changelog's content changes (changelog.html), one per version of a
    // tracked document, written only by the server (recordVersions).
    match /changelog/{id} {
      allow read: if may('changelog', 'view');
      allow write: if false;
    }

    // A person's settings (bold.js): skipConfirm, whether to skip the confirmation
    // before actions that reach outside BOLD.OS. Theirs alone, keyed by their uid.
    match /prefs/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['skipConfirm', 'at'])
        && request.resource.data.skipConfirm is bool && request.resource.data.at is number;
    }

    // A person's read points (read-point.js): which version of a document they
    // last marked as read. Theirs alone, keyed by their Firebase Auth uid.
    match /readPoints/{userId}/docs/{key} {
      allow read, delete: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['version', 'at', 'readAt'])
        && request.resource.data.version is string && request.resource.data.at is number;
    }

    // BOLDiquette and any other document edited like the guides
    // (handbook/{slug}; boldiquette.html): changed only by accepted proposals,
    // as guides are; never added or deleted from the site.
    // Readable by whoever the table lets view the BOLDiquette (everyone signed in, to start with).
    match /handbook/{slug} {
      allow read: if may('boldiquette', 'view');
      // Who has marked it read (read-point.js): readable by the lab; each
      // person writes only their own, under their uid and email.
      match /readers/{userId} {
        allow read: if may('boldiquette', 'view');
        allow delete: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['email', 'name', 'version', 'at', 'readAt'])
          && request.resource.data.email == email()
          && request.resource.data.version is string && request.resource.data.at is number;
      }
      allow write: if false;
      match /versions/{version} {
        allow read: if may('boldiquette', 'view');
        allow write: if false;
      }
      // Comments on selected text (comments.js): the lab reads and comments as
      // themselves; the author edits their text; the author or a PI/admin resolves or
      // deletes it; whoever started a thread can delete its replies with it.
      match /comments/{id} {
        allow read: if may('boldiquette', 'view');
        allow create: if may('boldiquette', 'edit') && request.resource.data.by.email == email()
          && request.resource.data.keys().hasOnly(['partId', 'quote', 'prefix', 'suffix', 'text', 'by', 'at', 'parent', 'proposalId'])
          && request.resource.data.partId is string && request.resource.data.at is number
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && ('parent' in request.resource.data
            ? request.resource.data.parent is string && exists(/databases/$(database)/documents/handbook/$(slug)/comments/$(request.resource.data.parent))
            // On a proposed change: its discussion.
            : 'proposalId' in request.resource.data
            ? request.resource.data.proposalId is string && exists(/databases/$(database)/documents/handbook/$(slug)/proposals/$(request.resource.data.proposalId))
            : request.resource.data.quote is string && request.resource.data.quote.size() > 0 && request.resource.data.quote.size() <= 500);
        allow update: if may('boldiquette', 'edit') && (
          (resource.data.by.email == email() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
            && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
            && (!('editedAt' in request.resource.data) || request.resource.data.editedAt is number))
          || ((resource.data.by.email == email() || hasFullWrite())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved', 'resolvedBy', 'resolvedByName', 'resolvedAt'])
            && request.resource.data.resolvedBy == email()));
        allow delete: if isSignedIn() && (resource.data.by.email == email() || hasFullWrite()
          || ('parent' in resource.data && resource.data.parent is string
            && get(/databases/$(database)/documents/handbook/$(slug)/comments/$(resource.data.parent)).data.by.email == email()));
      }
      // Who can see what (partId 'access') only PIs and admins propose changes to; one inside
      // a batch (which rules can't look into) is refused when accepted (decideProposal).
      // kind 'access': one page's row, from its eye chip (bold.js): { area, before, after:
      // { view, edit } }, set in the table when accepted.
      function validAccessRow(d) {
        return d.partId == 'access' && d.area is string && d.area.size() <= 40 &&
          d.after is map && d.after.keys().hasOnly(['view', 'edit']) && d.after.view is string && d.after.edit is string &&
          d.before is map && d.before.keys().hasOnly(['view', 'edit']);
      }
      match /proposals/{id} {
        allow read: if may('boldiquette', 'view');
        allow create: if may('boldiquette', 'edit') && request.resource.data.by.email == email()
          && (request.resource.data.get('partId', '') != 'access' || hasFullWrite())
          && request.resource.data.status == 'open'
          && request.resource.data.kind in ['about', 'edit', 'add', 'remove', 'move', 'restore', 'batch', 'access']
          && request.resource.data.keys().hasOnly(['kind', 'partId', 'area', 'before', 'after', 'note', 'by', 'at', 'status', 'changes'])
          && (request.resource.data.kind == 'access' ? validAccessRow(request.resource.data) : !('area' in request.resource.data))
          // Several changes proposed together (a draft): a list of them, as single proposals.
          && (request.resource.data.kind == 'batch'
            ? request.resource.data.changes is list && request.resource.data.changes.size() > 0 && request.resource.data.changes.size() <= 50
            : !('changes' in request.resource.data));
        // Edited by whoever proposed it, while it's open: its changes and note, as when
        // proposed; who, when and its status stay as they were.
        allow update: if may('boldiquette', 'edit') && resource.data.by.email == email() && resource.data.status == 'open'
          && (request.resource.data.get('partId', '') != 'access' || hasFullWrite())
          && request.resource.data.status == 'open' && request.resource.data.by == resource.data.by && request.resource.data.at == resource.data.at
          && request.resource.data.editedAt is number
          && request.resource.data.kind in ['about', 'edit', 'add', 'remove', 'move', 'batch']
          && request.resource.data.keys().hasOnly(['kind', 'partId', 'before', 'after', 'note', 'by', 'at', 'status', 'changes', 'editedAt'])
          && (request.resource.data.kind == 'batch'
            ? request.resource.data.changes is list && request.resource.data.changes.size() > 0 && request.resource.data.changes.size() <= 50
            : !('changes' in request.resource.data));
        // Withdrawn by whoever proposed it, while it's open.
        allow delete: if isSignedIn() && resource.data.by.email == email() && resource.data.status == 'open';
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
