{
  "name": "bold-os",
  "version": "1.0.0",
  "description": "BOLD Lab's tool suite for taking a paper from venue choice to conference presentation — an implementation of BOLDiquette § ML Conference Cycle.",
  "scripts": {
    "build": "eleventy",
