{
  "firestore": {
    "database": "(default)",
    "location": "europe-west2",
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "cp \"$PROJECT_DIR/src/assets/js/card-model.js\" \"$RESOURCE_DIR/card-model.js\"",
      "cp \"$PROJECT_DIR/src/assets/js/search-rank.js\" \"$RESOURCE_DIR/search-rank.js\""
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
